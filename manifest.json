{
  "manifest_version": 3,
  "name": "UKG Calendar Downloader",
  "version": "2.0.1",

  "description": "Save calendars as ICS files from UKG schedule page.",

  "icons": {},

  "browser_specific_settings": {
    "gecko": {
      "id": "ukgcalendar@example.com",
      "strict_min_version": "58.0"
    },
    "gecko_android": {}
  },

  "content_scripts": [
    {
      "matches": [
        "https://kwiktrip-sso.prd.mykronos.com/*",
        "https://kwiktrip-sso.prd.mykronos.com/ess#/"
        ],
      "js": ["make-cal.js"]
    }
  ]
}
  